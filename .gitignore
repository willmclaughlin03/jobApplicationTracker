.env

node_modules/
.next/

scripts/*
!scripts/
!scripts/billing-drain-checkout-sessions.mjs
!scripts/stripe-local-integration-check.mjs
!scripts/validate-build-env.js
!scripts/run-trusted-integration.js

# AI tailor feature — test fixtures contain canary strings (fake sk-/Bearer
# tokens) used to verify the credential scanner. Keep them out of git so
# secret scanners don't false-positive on the repo.
src/server/ai/__tests__/
src/server/db/__tests__/*
!src/server/db/__tests__/
!src/server/db/__tests__/billingMigrations.integration.test.js
!src/server/db/__tests__/jobsAtomicCreateQuota.integration.test.js
!src/server/db/__tests__/jobsStorageStateMigrations.integration.test.js
!src/server/db/__tests__/jobsOverflowLocking.integration.test.js
!src/server/db/__tests__/jobsPremiumRestore.integration.test.js
!src/server/db/__tests__/jobsPremiumRestoreReconciliation.integration.test.js
!src/server/db/__tests__/premiumRestoreReconciliationMigration.test.js
!src/server/db/__tests__/jobsLockedBulkDelete.integration.test.js
!src/server/db/__tests__/jobsStorageDegradationFinal.integration.test.js
!src/server/db/__tests__/jobsOrderedReadsIndexes.integration.test.js
!src/server/db/__tests__/migrations.integration.test.js
src/shared/schemas/__tests__/*
!src/shared/schemas/__tests__/profile.integration.test.js
!src/shared/schemas/__tests__/fixtures/
src/shared/schemas/__tests__/fixtures/*
!src/shared/schemas/__tests__/fixtures/profiles/
!src/shared/schemas/__tests__/fixtures/profiles/*.json

.tmp/
.codex-pr-*/
