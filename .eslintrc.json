{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "next/core-web-vitals"
  ],
  "ignorePatterns": [
    ".next/**",
    ".tmp/**",
    ".codex-pr-*/**",
    "package.json"
  ],
  "rules": {
    "no-constant-condition": [
      "error",
      {
        "checkLoops": false
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/__tests__/**/*.{js,jsx}",
        "**/*.{test,spec}.{js,jsx}",
        "jest.setup.js"
      ],
      "env": {
        "jest": true
      }
    }
  ]
}
