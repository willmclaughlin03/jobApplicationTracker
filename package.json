{
  "name": "track-the-app",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "lint": "eslint . --max-warnings=0",
    "build": "npm run build:preflight && next build",
    "build:preflight": "node scripts/validate-build-env.js",
    "billing:drain-checkout": "node scripts/billing-drain-checkout-sessions.mjs",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest \"--testPathIgnorePatterns=/node_modules/\" \"--testPathIgnorePatterns=/\\.next/\" \"--testPathIgnorePatterns=<rootDir>/\\.tmp/\" \"--testPathIgnorePatterns=<rootDir>/\\.tmp/worktrees/\" \"--testPathIgnorePatterns=<rootDir>/\\.codex-pr-[^/]+/\" \"--testPathIgnorePatterns=integration[.]test[.]js$\"",
    "test:integration:list": "jest --listTests --testPathPattern=integration[.]test[.]js$",
    "test:integration": "npm run test:integration:list && jest --testPathPattern=integration[.]test[.]js$ --runInBand --verbose",
    "test:ci": "jest --ci --runInBand --no-cache \"--testPathIgnorePatterns=/node_modules/\" \"--testPathIgnorePatterns=/\\.next/\" \"--testPathIgnorePatterns=<rootDir>/\\.tmp/\" \"--testPathIgnorePatterns=<rootDir>/\\.tmp/worktrees/\" \"--testPathIgnorePatterns=<rootDir>/\\.codex-pr-[^/]+/\" \"--testPathIgnorePatterns=integration[.]test[.]js$\"",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@axiomhq/pino": "^1.5.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.2",
    "cookie": "^1.1.1",
    "dotenv": "^17.2.3",
    "isomorphic-dompurify": "^2.36.0",
    "lucide-react": "^1.27.0",
    "next": "16.3.3",
    "pino": "^10.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stripe": "^22.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/plugin-transform-private-methods": "^7.28.6",
    "@babel/runtime": "^7.28.6",
    "@eslint/js": "9.39.5",
    "autoprefixer": "^10.4.23",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "globals": "^16.5.0",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "patch-package": "^8.0.1",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19"
  },
  "overrides": {
    "isomorphic-dompurify": {
      "jsdom": "25.0.1"
    },
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.4"
    }
  }
}
